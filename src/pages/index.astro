---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Auto Tech Blog" description="自動生成される技術ブログ">
  <h1>記事一覧</h1>
  <ul>
    {posts.map((p) => (
      <li>
        <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
        <a href={`/posts/${p.id}/`}>{p.data.title}</a>
      </li>
    ))}
  </ul>
</Base>
